// Copy this file to include/secrets.h (git-ignored) and fill in your values.
// Never commit include/secrets.h.
#pragma once

#define WIFI_SSID        "your-orbi-ssid"
#define WIFI_PASSWORD    "your-wifi-password"

// Cerbo GX: hostname or IP of the Venus device on the house network.
// venus.local works when mDNS resolves on your network; otherwise the IP.
#define MQTT_HOST        "venus.local"
#define MQTT_PORT        1883
// VRM portal id of the Cerbo (12 hex chars, Settings -> VRM online portal -> VRM Portal ID)
#define VRM_PORTAL_ID    "000000000000"

// Over-the-air update password (hostname comes from include/devices.h). Same password in secrets.ini.
#define OTA_PASSWORD     "choose-a-password"
