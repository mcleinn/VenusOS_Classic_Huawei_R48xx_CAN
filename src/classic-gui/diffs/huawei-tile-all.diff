 	property alias pvOnAcIn2: _pvOnAcIn2
@@ -164,4 +165,16 @@
 		id: _dcSystem
 		property VBusItem power: VBusItem { bind: Utils.path(systemPrefix, "/Dc/System/Power"); unit: "W"}
 	}
+
+	// Managed (Huawei) chargers. Power is the stock systemcalc sum of all
+	// com.victronenergy.charger services; the active count comes from the
+	// Huawei DVCC patch (chargers that are connected and not in State 0).
+	QtObject {
+		id: _huawei
+		property VBusItem power: VBusItem { bind: Utils.path(systemPrefix, "/Dc/Charger/Power"); unit: "W"}
+		property VBusItem active: VBusItem { bind: Utils.path(systemPrefix, "/Dvcc/Chargers/Active") }
+		// per unit, ordered by serial (invalid when the unit is absent)
+		property VBusItem power0: VBusItem { bind: Utils.path(systemPrefix, "/Dvcc/Chargers/0/Power"); unit: "W"}
+		property VBusItem power1: VBusItem { bind: Utils.path(systemPrefix, "/Dvcc/Chargers/1/Power"); unit: "W"}
+	}
 }
