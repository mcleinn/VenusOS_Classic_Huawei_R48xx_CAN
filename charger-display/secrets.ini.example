[ota]
host = charger-display-1.local
password = choose-a-password
host2 = charger-display-2.local
port2 = COM12
; Pi access point the displays join (connman tethering on the Venus Pi)
ap_ssid = my-charger-ap
ap_psk = choose-a-passphrase
; the Venus device's LAN address (tools/push_espota_via_pi.sh) and the boards' MACs (tools/push_via_pi.sh)
venus_lan_ip = 192.168.1.100
mac1 = aa:bb:cc:dd:ee:01
mac2 = aa:bb:cc:dd:ee:02
